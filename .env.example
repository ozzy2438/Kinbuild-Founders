# Public build-time settings, not credentials. Local development stays a preview.
VITE_REGISTRATION_MODE=preview

# Approved temporary public contact. Replace when a project address is ready.
VITE_CONTACT_EMAIL=osmanorka@gmail.com

# Optional. Absolute site address for link-preview images; Netlify builds use URL automatically.
# VITE_SITE_URL=https://startbeside.netlify.app

# Optional. "on" shows anonymous registration totals via netlify/functions/community-pulse.mjs,
# which also needs NETLIFY_FORMS_TOKEN (and optionally PULSE_MIN_TOTAL) set in Netlify.
VITE_COMMUNITY_PULSE=off
